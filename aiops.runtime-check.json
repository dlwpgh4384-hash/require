{
  "schema_version": 1,
  "backend": {
    "service": "backend",
    "container_port": 8080,
    "health": {
      "operation_id": "getHealth",
      "method": "GET",
      "path": "/api/health",
      "expect": [
        { "path": "success", "op": "type", "value": "boolean" },
        { "path": "success", "op": "equals", "value": true }
      ]
    }
  },
  "auth": { "required": false },
  "first_menu": {
    "route": "/",
    "operation_id": "getCommonMenus",
    "method": "GET",
    "path": "/api/common/menus",
    "expect": [{ "path": "data", "op": "type", "value": "array" }]
  }
}
