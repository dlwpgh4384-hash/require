<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.common.commonops.UserOptionsMapper">
  <resultMap id="userOptionRole"
             type="com.company.common.commonops.UserOptionRows$Role"
             autoMapping="false">
    <result column="role_cd" property="roleCd" javaType="java.lang.String"/>
    <result column="role_name" property="roleName" javaType="java.lang.String"/>
    <result column="assigned_project_scope" property="assignedProjectScope" javaType="_boolean"/>
  </resultMap>
  <resultMap id="userOptionProject"
             type="com.company.common.commonops.UserOptionRows$Project"
             autoMapping="false">
    <result column="project_id" property="projectId" javaType="java.lang.String"/>
    <result column="project_name" property="projectName" javaType="java.lang.String"/>
  </resultMap>
  <resultMap id="userOptionState"
             type="com.company.common.commonops.UserOptionRows$UserState"
             autoMapping="false">
    <result column="code" property="code" javaType="java.lang.String"/>
    <result column="name" property="name" javaType="java.lang.String"/>
  </resultMap>
  <select id="selectRoles" resultMap="userOptionRole">
    SELECT r.ROLE_ID AS role_cd, r.ROLE_NM AS role_name,
           (r.DATA_SCOPE_CD = 'PROJ') AS assigned_project_scope
    FROM TB_SY_ROLE r
    ORDER BY r.SORT_ORD, r.ROLE_ID
  </select>
  <select id="selectProjects" resultMap="userOptionProject">
    SELECT p.PROJ_ID AS project_id, p.PROJ_NM AS project_name
    FROM TB_PJ_PROJ p
    ORDER BY p.PROJ_NM, p.PROJ_ID
  </select>
  <select id="selectUserStates" resultMap="userOptionState">
    SELECT c.CODE AS code, c.CODE_NM AS name
    FROM TB_SY_CODE c
    WHERE c.CODE_GRP_ID = 'USER_STAT'
    ORDER BY c.SORT_ORD, c.CODE
  </select>
</mapper>
