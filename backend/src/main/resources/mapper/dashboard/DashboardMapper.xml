<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.common.dashboard.mapper.DashboardMapper">
  <resultMap id="utilizationRow" type="com.company.common.dashboard.mapper.DashboardMapper$Utilization" autoMapping="false">
    <constructor>
      <arg column="totalPeople" javaType="_int"/>
      <arg column="assignedPeople" javaType="_int"/>
    </constructor>
  </resultMap>
  <select id="utilization" resultMap="utilizationRow">
    SELECT count(*)::integer AS "totalPeople", count(*) FILTER (WHERE EXISTS (
      SELECT 1 FROM TB_PJ_ASGN_MON m JOIN TB_PJ_ASGN a ON a.ASGN_ID=m.ASGN_ID AND a.ASGN_STAT_CD='ACT'
      WHERE m.DEV_ID=d.DEV_ID AND m.INPUT_YM=#{month} AND m.MON_MM &gt; 0
    ))::integer AS "assignedPeople"
    FROM TB_HR_DEV d WHERE d.DRCT_CLS_CD='DRCT'
      AND (d.JNCMP_DT IS NULL OR d.JNCMP_DT &lt;= #{last})
      AND (d.RETIRE_DT IS NULL OR d.RETIRE_DT &gt;= #{first})
    <!-- 데이터 범위(명세 ⑧-4, 시안 putil): 전체가 아니면 「내 파트」 소속 인력, 「내 프로젝트」만이면 그 달 맡은 프로젝트에 투입된 인력. -->
    <bind name="scopeAll" value="@com.company.common.support.auth.RequestAccess@scopeAll()"/>
    <bind name="scopeParts" value="@com.company.common.support.auth.RequestAccess@scopeParts()"/>
    <bind name="scopeProjects" value="@com.company.common.support.auth.RequestAccess@scopeProjects()"/>
    <if test="!scopeAll">
      AND (FALSE
      <if test="!scopeParts.isEmpty()">OR d.PART_ID IN <foreach collection="scopeParts" item="scopePart" open="(" separator="," close=")">#{scopePart}</foreach></if>
      <if test="scopeParts.isEmpty() and !scopeProjects.isEmpty()">OR EXISTS (SELECT 1 FROM TB_PJ_ASGN_MON sm WHERE sm.DEV_ID=d.DEV_ID
        AND sm.INPUT_YM=#{month} AND sm.MON_MM &gt; 0
        AND sm.PROJ_ID IN <foreach collection="scopeProjects" item="scopeProject" open="(" separator="," close=")">#{scopeProject}</foreach>)</if>)
    </if>
  </select>
  <insert id="insertAccess">
    <bind name="accessIp" value="@com.company.common.support.auth.RequestAccess@ip()"/>
    INSERT INTO TB_SY_ACCS_LOG (USER_ID,ACT_TYPE_CD,SCRN_ID,TRGT_DESC,ACT_DTTM,REG_USER_ID,REG_DTTM,CLIENT_IP)
    VALUES (#{actor},'DNLD','UI-16',#{target},clock_timestamp(),#{actor},clock_timestamp(),#{accessIp,jdbcType=VARCHAR})
  </insert>
</mapper>
